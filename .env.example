# TikTok app credentials for @yusshhik (Sandbox or approved production app).
# Without credentials: saved real videos via oEmbed + official creator embed.
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# npm run connect:tiktok stores the actual granted scopes with the tokens.
TIKTOK_SCOPES=user.info.basic,video.list,user.info.profile,user.info.stats
PORT=4173
HOST=127.0.0.1
